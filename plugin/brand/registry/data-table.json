{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "data-table",
  "type": "registry:ui",
  "title": "Data table",
  "description": "A table from columns and data: sorting, search, filters, pages, column visibility and selection.",
  "dependencies": [
    "@lucide/vue",
    "@tanstack/vue-table"
  ],
  "registryDependencies": [
    "https://design.aisgroup.ai/r/utils.json",
    "https://design.aisgroup.ai/r/checkbox.json",
    "https://design.aisgroup.ai/r/empty.json",
    "https://design.aisgroup.ai/r/pagination.json",
    "https://design.aisgroup.ai/r/skeleton.json",
    "https://design.aisgroup.ai/r/table.json",
    "https://design.aisgroup.ai/r/button.json",
    "https://design.aisgroup.ai/r/badge.json",
    "https://design.aisgroup.ai/r/command.json",
    "https://design.aisgroup.ai/r/popover.json",
