{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "data-table",
  "type": "registry:ui",
  "title": "Data table",
  "description": "A table from columns and data: sorting, search, filters, pages, column visibility and selection.",
  "dependencies": [
    "@lucide/vue",
    "@tanstack/vue-table"
  ],
  "registryDependencies": [
    "https://design.aisgroup.ai/r/utils.json",
    "https://design.aisgroup.ai/r/checkbox.json",
    "https://design.aisgroup.ai/r/empty.json",
    "https://design.aisgroup.ai/r/pagination.json",
    "https://design.aisgroup.ai/r/skeleton.json",
    "https://design.aisgroup.ai/r/table.json",
    "https://design.aisgroup.ai/r/button.json",
    "https://design.aisgroup.ai/r/dropdown-menu.json"
  ],
  "files": [
    {
      "path": "components/ui/data-table/DataTable.vue",
      "type": "registry:ui",
      "content": "<script setup lang=\"ts\" generic=\"TData extends RowData\">\nimport type { ColumnDef, RowData, RowSelectionState } from '@tanstack/vue-table'\nimport type { HTMLAttributes } from 'vue'\nimport { FlexRender, useTable } from '@tanstack/vue-table'\nimport { SearchXIcon } from '@lucide/vue'\nimport { computed, h } from 'vue'\nimport { cn } from '@/lib/utils'\nimport { Checkbox } from '@/components/ui/checkbox'\nimport { Empty, EmptyHeader, EmptyMedia, EmptyTitle } from '@/components/ui/empty'\nimport { Pagination, PaginationContent, PaginationEllipsis, PaginationItem, PaginationNext, PaginationPrevious } from '@/components/ui/pagination'\nimport { Skeleton } from '@/components/ui/skeleton'\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table'\nimport { dataTableFeatures, type DataTableFeatures } from '.'\nimport DataTableColumnHeader from './DataTableColumnHeader.vue'\n\n// shadcn-vue's data table as one component: columns and data in; sorting, filters, pages, column visibility and row\n// selection inside. A string header becomes a sortable header; `meta: { numeric: true }` right-aligns a number column\n// with tabular figures; a `cell-<column id>` slot renders that column's cells. Toolbar, summary and empty are slots.\n// ponytail: client-side rows only; for server pages pass manual pagination through TanStack options when an app needs it.\nconst props = withDefaults(defineProps<{\n  columns: ColumnDef<DataTableFeatures, TData, any>[]\n  data: TData[]\n  loading?: boolean\n  selectable?: boolean\n  pageSize?: number\n  getRowId?: (row: TData, index: number) => string\n  labels?: { selectAll?: string, selectRow?: string, empty?: string, previous?: string, next?: string }\n  class?: HTMLAttributes['class']\n}>(), {\n  pageSize: 10,\n})\n\nconst rowSelection = defineModel<RowSelectionState>('rowSelection', { default: () => ({}) })\nconst globalFilter = defineModel<string>('globalFilter', { default: '' })\n\nconst text = computed(() => ({ selectAll: 'Select all', selectRow: 'Select row', empty: 'No results', previous: 'Previous', next: 'Next', ...props.labels }))\n\nconst selectColumn: ColumnDef<DataTableFeatures, TData, unknown> = {\n  id: 'select',\n  header: ({ table }) => h(Checkbox, {\n    'modelValue': table.getIsAllPageRowsSelected() || (table.getIsSomePageRowsSelected() && 'indeterminate'),\n    'onUpdate:modelValue': (value: boolean | 'indeterminate') => table.toggleAllPageRowsSelected(!!value),\n    'aria-label': text.value.selectAll,\n  }),\n  cell: ({ row }) => h(Checkbox, {\n    'modelValue': row.getIsSelected(),\n    'onUpdate:modelValue': (value: boolean | 'indeterminate') => row.toggleSelected(!!value),\n    'aria-label': text.value.selectRow,\n  }),\n  enableSorting: false,\n  enableHiding: false,\n}\n\nconst table = useTable({\n  features: dataTableFeatures,\n  get data() { return props.data },\n  get columns() { return props.selectable ? [selectColumn, ...props.columns] : props.columns },\n  get enableRowSelection() { return props.selectable },\n  get getRowId() { return props.getRowId },\n  globalFilterFn: 'includesString',\n  initialState: { pagination: { pageIndex: 0, pageSize: props.pageSize } },\n  state: {\n    get rowSelection() { return rowSelection.value },\n    get globalFilter() { return globalFilter.value },\n  },\n  onRowSelectionChange: (updater) => { rowSelection.value = typeof updater === 'function' ? updater(rowSelection.value) : updater },\n  onGlobalFilterChange: (updater) => { globalFilter.value = typeof updater === 'function' ? updater(globalFilter.value) : updater },\n})\n\nconst pagination = computed(() => table.atoms.pagination.get())\nconst visibleColumns = computed(() => table.getVisibleLeafColumns())\nconst numeric = (meta?: { numeric?: boolean }) => (meta?.numeric ? 'text-right tabular-nums' : '')\nconst ariaSort = (sorted: false | 'asc' | 'desc') => (sorted === 'asc' ? 'ascending' : sorted === 'desc' ? 'descending' : undefined)\n\ndefineExpose({ table })\n</script>\n\n<template>\n  <div data-slot=\"data-table\" :class=\"cn('flex w-full flex-col gap-4', props.class)\">\n    <slot name=\"toolbar\" :table=\"table\" />\n    <Table>\n      <TableHeader>\n        <TableRow v-for=\"headerGroup in table.getHeaderGroups()\" :key=\"headerGroup.id\">\n          <TableHead\n            v-for=\"header in headerGroup.headers\"\n            :key=\"header.id\"\n            :class=\"numeric(header.column.columnDef.meta)\"\n            :aria-sort=\"header.column.getCanSort() ? ariaSort(header.column.getIsSorted()) : undefined\"\n          >\n            <template v-if=\"!header.isPlaceholder\">\n              <DataTableColumnHeader v-if=\"typeof header.column.columnDef.header === 'string'\" :column=\"header.column\" :title=\"header.column.columnDef.header\" />\n              <FlexRender v-else :header=\"header\" />\n            </template>\n          </TableHead>\n        </TableRow>\n      </TableHeader>\n      <TableBody>\n        <template v-if=\"loading\">\n          <TableRow v-for=\"i in pagination.pageSize\" :key=\"i\">\n            <TableCell v-for=\"column in visibleColumns\" :key=\"column.id\">\n              <Skeleton :class=\"column.columnDef.meta?.numeric ? 'ml-auto h-4 w-12' : 'h-4 w-full max-w-40'\" />\n            </TableCell>\n          </TableRow>\n        </template>\n        <template v-else-if=\"table.getRowModel().rows.length\">\n          <TableRow v-for=\"row in table.getRowModel().rows\" :key=\"row.id\" :data-state=\"row.getIsSelected() ? 'selected' : undefined\">\n            <TableCell v-for=\"cell in row.getVisibleCells()\" :key=\"cell.id\" :class=\"numeric(cell.column.columnDef.meta)\">\n              <slot :name=\"`cell-${cell.column.id}`\" v-bind=\"cell.getContext()\">\n                <FlexRender :cell=\"cell\" />\n              </slot>\n            </TableCell>\n          </TableRow>\n        </template>\n        <TableRow v-else class=\"hover:bg-transparent\">\n          <TableCell :colspan=\"visibleColumns.length\" class=\"p-0\">\n            <slot name=\"empty\">\n              <Empty class=\"p-10\">\n                <EmptyHeader>\n                  <EmptyMedia><SearchXIcon class=\"size-6 text-muted-foreground\" /></EmptyMedia>\n                  <EmptyTitle>{{ text.empty }}</EmptyTitle>\n                </EmptyHeader>\n              </Empty>\n            </slot>\n          </TableCell>\n        </TableRow>\n      </TableBody>\n    </Table>\n    <div v-if=\"!loading && (selectable || table.getPageCount() > 1)\" class=\"flex items-center justify-between gap-4\">\n      <span class=\"text-muted-foreground\">\n        <slot name=\"summary\" :table=\"table\">\n          <template v-if=\"selectable\">{{ table.getFilteredSelectedRowModel().rows.length }} of {{ table.getFilteredRowModel().rows.length }} selected</template>\n          <template v-else>Page {{ pagination.pageIndex + 1 }} of {{ table.getPageCount() }}</template>\n        </slot>\n      </span>\n      <Pagination\n        v-if=\"table.getPageCount() > 1\"\n        v-slot=\"{ page }\"\n        :page=\"pagination.pageIndex + 1\"\n        :total=\"table.getFilteredRowModel().rows.length\"\n        :items-per-page=\"pagination.pageSize\"\n        :sibling-count=\"1\"\n        class=\"mx-0 w-auto\"\n        @update:page=\"(page: number) => table.setPageIndex(page - 1)\"\n      >\n        <PaginationContent v-slot=\"{ items }\">\n          <PaginationPrevious :label=\"text.previous\" />\n          <template v-for=\"(item, i) in items\" :key=\"i\">\n            <PaginationItem v-if=\"item.type === 'page'\" :value=\"item.value\" :is-active=\"item.value === page\">{{ item.value }}</PaginationItem>\n            <PaginationEllipsis v-else :index=\"i\" />\n          </template>\n          <PaginationNext :label=\"text.next\" />\n        </PaginationContent>\n      </Pagination>\n    </div>\n  </div>\n</template>\n"
    },
    {
      "path": "components/ui/data-table/DataTableColumnHeader.vue",
      "type": "registry:ui",
      "content": "<script setup lang=\"ts\" generic=\"TData extends RowData, TValue extends CellData\">\nimport type { CellData, Column, RowData } from '@tanstack/vue-table'\nimport type { HTMLAttributes } from 'vue'\nimport type { DataTableFeatures } from '.'\nimport { ArrowDownIcon, ArrowUpDownIcon, ArrowUpIcon } from '@lucide/vue'\nimport { cn } from '@/lib/utils'\nimport { Button } from '@/components/ui/button'\n\n// A sortable header: a ghost button that sorts ascending, then descending. Number columns align it to the right.\nconst props = defineProps<{\n  column: Column<DataTableFeatures, TData, TValue>\n  title: string\n  class?: HTMLAttributes['class']\n}>()\n</script>\n\n<template>\n  <Button\n    v-if=\"column.getCanSort()\"\n    data-slot=\"data-table-column-header\"\n    variant=\"ghost\"\n    size=\"sm\"\n    :class=\"cn(column.columnDef.meta?.numeric ? '-mr-2.5' : '-ml-2.5', props.class)\"\n    @click=\"column.toggleSorting(column.getIsSorted() === 'asc')\"\n  >\n    {{ title }}\n    <ArrowUpIcon v-if=\"column.getIsSorted() === 'asc'\" data-icon=\"inline-end\" />\n    <ArrowDownIcon v-else-if=\"column.getIsSorted() === 'desc'\" data-icon=\"inline-end\" />\n    <ArrowUpDownIcon v-else data-icon=\"inline-end\" class=\"text-muted-foreground\" />\n  </Button>\n  <span v-else data-slot=\"data-table-column-header\" :class=\"props.class\">{{ title }}</span>\n</template>\n"
    },
    {
      "path": "components/ui/data-table/DataTableViewOptions.vue",
      "type": "registry:ui",
      "content": "<script setup lang=\"ts\">\nimport type { VueTable } from '@tanstack/vue-table'\nimport type { HTMLAttributes } from 'vue'\nimport type { DataTableFeatures } from '.'\nimport { Columns3Icon } from '@lucide/vue'\nimport { computed } from 'vue'\nimport { cn } from '@/lib/utils'\nimport { Button } from '@/components/ui/button'\nimport { DropdownMenu, DropdownMenuCheckboxItem, DropdownMenuContent, DropdownMenuTrigger } from '@/components/ui/dropdown-menu'\n\n// The columns a person can show or hide, named by their header.\nconst props = withDefaults(defineProps<{\n  table: VueTable<DataTableFeatures, any>\n  label?: string\n  class?: HTMLAttributes['class']\n}>(), {\n  label: 'Columns',\n})\n\nconst columns = computed(() => props.table.getAllColumns().filter(column => column.accessorFn !== undefined && column.getCanHide()))\nconst nameOf = (header: unknown, id: string) => (typeof header === 'string' ? header : id)\n</script>\n\n<template>\n  <DropdownMenu>\n    <DropdownMenuTrigger as-child>\n      <Button data-slot=\"data-table-view-options\" variant=\"outline\" :class=\"cn(props.class)\">\n        <Columns3Icon data-icon=\"inline-start\" />{{ label }}\n      </Button>\n    </DropdownMenuTrigger>\n    <DropdownMenuContent align=\"end\" class=\"w-48\">\n      <DropdownMenuCheckboxItem\n        v-for=\"column in columns\"\n        :key=\"column.id\"\n        :model-value=\"column.getIsVisible()\"\n        @select.prevent\n        @update:model-value=\"(value) => column.toggleVisibility(!!value)\"\n      >\n        {{ nameOf(column.columnDef.header, column.id) }}\n      </DropdownMenuCheckboxItem>\n    </DropdownMenuContent>\n  </DropdownMenu>\n</template>\n"
    },
    {
      "path": "components/ui/data-table/index.ts",
      "type": "registry:ui",
      "content": "import type { CellData, RowData, TableFeatures } from '@tanstack/vue-table'\nimport {\n  columnFilteringFeature,\n  columnVisibilityFeature,\n  createFilteredRowModel,\n  createPaginatedRowModel,\n  createSortedRowModel,\n  filterFn_arrIncludes,\n  filterFn_arrIncludesSome,\n  filterFn_equals,\n  filterFn_equalsString,\n  filterFn_includesString,\n  filterFn_inDateRange,\n  filterFn_inNumberRange,\n  filterFn_weakEquals,\n  globalFilteringFeature,\n  rowPaginationFeature,\n  rowSelectionFeature,\n  rowSortingFeature,\n  sortFn_alphanumeric,\n  sortFn_basic,\n  sortFn_datetime,\n  sortFn_text,\n  tableFeatures,\n} from '@tanstack/vue-table'\n\nexport { default as DataTable } from './DataTable.vue'\nexport { default as DataTableColumnHeader } from './DataTableColumnHeader.vue'\nexport { default as DataTableViewOptions } from './DataTableViewOptions.vue'\n\n// What every DataTable can do (TanStack Table v9 registers features one by one). Columns pick their filter and sort\n// functions by these names, or leave them on 'auto'.\nexport const dataTableFeatures = tableFeatures({\n  columnFilteringFeature,\n  columnVisibilityFeature,\n  globalFilteringFeature,\n  rowPaginationFeature,\n  rowSelectionFeature,\n  rowSortingFeature,\n  filteredRowModel: createFilteredRowModel(),\n  paginatedRowModel: createPaginatedRowModel(),\n  sortedRowModel: createSortedRowModel(),\n  filterFns: {\n    includesString: filterFn_includesString,\n    equalsString: filterFn_equalsString,\n    equals: filterFn_equals,\n    weakEquals: filterFn_weakEquals,\n    arrIncludes: filterFn_arrIncludes,\n    arrIncludesSome: filterFn_arrIncludesSome,\n    inNumberRange: filterFn_inNumberRange,\n    inDateRange: filterFn_inDateRange,\n  },\n  sortFns: { alphanumeric: sortFn_alphanumeric, text: sortFn_text, datetime: sortFn_datetime, basic: sortFn_basic },\n})\n\nexport type DataTableFeatures = typeof dataTableFeatures\n\ndeclare module '@tanstack/vue-table' {\n  interface ColumnMeta<in out TFeatures extends TableFeatures, in out TData extends RowData, TValue extends CellData = CellData> {\n    /** A number column: header and cells right-aligned, with tabular figures. */\n    numeric?: boolean\n  }\n}\n"
    }
  ],
  "meta": {
    "package": "@aisgroup/design@0.0.0",
    "source": "rosepetal-ai/aisgroup-design@dev:packages/design/ui/data-table/DataTable.vue"
  }
}