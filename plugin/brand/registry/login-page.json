85-3.68 0-4.6-1.68-4.6-3.89m9.51-2.25v-1h-.6c-5.69 0-7.09.62-7.09 3.09 0 1.56.71 2.46 3.13 2.46 3.29 0 4.65-1.42 4.65-4.6\"/><path d=\"m113.71 15.29v-15.29h1.77v15.1c0 1.28.17 1.73 1.52 1.73h.56v1.57c-.19 0-.63 0-1.13 0-2.13 0-2.72-.92-2.72-3.15\"/></g></svg>"
