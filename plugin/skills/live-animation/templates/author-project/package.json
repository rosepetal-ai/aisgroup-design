{
  "name": "ais-inspection-animation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config skills/live-animation/examples/enclosed-inspection/vite.config.mjs",
    "build": "vite build --config skills/live-animation/examples/enclosed-inspection/vite.config.mjs && node skills/live-animation/examples/enclosed-inspection/pack.mjs skills/live-animation/examples/enclosed-inspection/dist index.html",
    "check": "node --experimental-strip-types --test skills/live-animation/examples/enclosed-inspection/optical-sightline.test.mjs && node skills/live-animation/examples/enclosed-inspection/check.mjs",
    "prebuild": "node scripts/animation-assets.mjs",
    "predev": "node scripts/animation-assets.mjs",
    "film": "node skills/live-animation/examples/enclosed-inspection/export-film.mjs",
    "detail": "node skills/live-animation/examples/enclosed-inspection/capture-detail.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@lucide/vue": "1.81.0",
    "@vueuse/core": "15.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.1",
    "three": "0.187.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.11",
    "tailwindcss": "4.3.3",
    "vite": "8.3.8",
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  }
}
