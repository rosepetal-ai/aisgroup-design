  "generators": {
    "_note": "The only generators. Every piece type routes here; HTML is always written first, PDF/PNG/PPTX only on request. Rejected systems: figures/machine-pieces.mjs, work/brochures/_final (v1), marketing-kit-review-2026-10-28 drafts, public/kit brochure pages, any hexagon drawing not from print/pattern.py.",
    "brochure": {
      "skill": "brochure",
      "source": "pieces/brochures/<piece>/<name>.<lang>.html",
      "stylesheet": "print/system.css",
      "references": [
        "pieces/brochures/cables/cables.es.html",
        "pieces/brochures/compact/compact.es.html",
        "pieces/brochures/hopper/hopper.es.html"
      ],
      "html": "edit the source (copy the closest reference)",
      "pdf": "node print/render.mjs <html>",
      "outputs": {
        "pdf": "<name>.<lang>.pdf",
        "png": "previews/<name>.<lang>-N.png"
      }
    },
    "catalogue": {
