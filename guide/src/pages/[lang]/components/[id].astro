---
import previewHeights from '../../../data/preview-heights.json';
// One component or block of @aisgroup/design: each of its examples live (rendered from packages/design/examples) and its code.
// The example's first comment is the line under the title.
import { getCollection } from 'astro:content';
import { Code } from 'astro:components';
import Guide from '../../../layouts/Guide.astro';
import { languages, order, ui, type Lang } from '../../../i18n';
import { localizePart, examples, parts, type CatalogItem } from '../../../design/package';

export async function getStaticPaths() {
  const entries = await getCollection('guide');
  const slugOf = (id: string) => id.split('/').slice(1).join('/') || 'index';
  const find = (lang: string, slug: string) => entries.find((e) => e.id.split('/')[0] === lang && slugOf(e.id) === slug);
  return Object.keys(languages).flatMap((lang) => {
    const titles = Object.fromEntries(order.map((slug) => [slug, (find(lang, slug) ?? find('en', slug))!.data.title]));
    return parts.map((part) => ({ params: { lang, id: part.id }, props: { lang, titles, part: localizePart(part, lang as Lang) } }));
  });
}
const { lang, titles, part } = Astro.props as { lang: Lang; titles: Record<string, string>; part: CatalogItem };
const list = examples(part.id, lang);
// A playground running next to the guide (PUBLIC_PLAYGROUND_URL, e.g. http://localhost:5173 with npm run dev:playground) gets a link to the same page.
const playground = import.meta.env.PUBLIC_PLAYGROUND_URL;
const label = { en: 'Open in the playground', es: 'Abrir en el playground', ca: 'Obre al playground' }[lang];
const t = ui[lang];
---
<Guide lang={lang} slug="components" title={part.name} headings={list.map((e) => ({ depth: 2, slug: e.slug, text: e.name }))} titles={titles}>
  <p>{part.description}</p>
  {playground && <p><a href={`${playground.replace(/\/$/, '')}/#${part.id}`}>{label}</a></p>}
  <div class="theme-switch" role="group" aria-label={`${t.light} / ${t.dark}`}>
    <button type="button" data-theme="light" aria-pressed="true">{t.light}</button><button type="button" data-theme="dark" aria-pressed="false">{t.dark}</button>
  </div>
  {list.map((e) => (
    <>
      <h2 id={e.slug}>{e.name}</h2>
      {e.about && <p>{e.about}</p>}
      <iframe class="preview" src={`/preview/${e.path}/`} title={e.name} loading="lazy" style={previewHeights[`/preview/${e.path}/`] ? `height:${previewHeights[`/preview/${e.path}/`]}px` : undefined}></iframe>
      <Code code={e.code} lang="vue" theme="github-light" />
    </>
  ))}
  <script is:inline>
    // Runs again after every page change (client router): its own scope, and its listener leaves with the page.
    (() => { const page = new AbortController(); document.addEventListener('astro:before-swap', () => page.abort(), { once: true });
    // Each preview reports its height; the frame takes it, so a preview never scrolls inside the page.
    // The switch shows every preview in light or dark; a preview that loads later gets the theme when it first reports.
    let theme = 'light';
    try { theme = localStorage.getItem('guide-preview-theme') === 'dark' ? 'dark' : 'light'; } catch {}
    const buttons = document.querySelectorAll('.theme-switch button');
    const show = (next) => {
      theme = next;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.theme === theme)));
      document.querySelectorAll('iframe.preview').forEach((f) => f.contentWindow?.postMessage({ theme }, '*'));
      try { localStorage.setItem('guide-preview-theme', theme); } catch {}
    };
    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.theme)));
    show(theme);
    addEventListener('message', (m) => { if (!m.data?.preview) return;
      m.source?.postMessage({ theme }, '*');
      for (const f of document.querySelectorAll('iframe.preview')) if (new URL(f.src).pathname === m.data.preview) f.style.height = `${m.data.height}px`; }, { signal: page.signal });
    })();
  </script>
  <style>
    .theme-switch { display: inline-flex; margin: 8px 0 0; border: 1px solid var(--line); }
    .theme-switch button { border: 0; background: #fff; color: var(--muted); font: 500 var(--ais-text-small)/var(--ais-text-small-leading) var(--ais-font-primary); padding: 6px 14px; min-height: 36px; cursor: pointer; }
    .theme-switch button[aria-pressed='true'] { background: var(--ink); color: #fff; }
    .theme-switch button:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
  </style>
</Guide>
