---
import {fixture} from '../../../../data/web-fixtures';
import '@aisgroup/web/styles.css';
export function getStaticPaths(){return ['en','es','ca'].flatMap(lang=>['language-picker','page-opener','lead-form','product-film'].map(kind=>({params:{lang,kind}})));}
const {lang,kind}=Astro.params;const example=fixture(kind!,lang as 'en'|'es'|'ca');
---
<html lang={lang} data-brand="ais-vision"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><style is:global>
@font-face{font-family:Inter;font-weight:400 700;font-display:swap;src:url('/fonts/inter-latin.woff2')}*{box-sizing:border-box}body{margin:0;padding:24px;background:var(--web-page);color:var(--web-ink);font:400 var(--ais-text-body)/var(--ais-text-body-leading) Inter,sans-serif}.page-opener{display:grid;grid-template-columns:1fr 1fr;gap:32px}h1{font-size:var(--ais-text-title);font-weight:var(--ais-text-title-weight);line-height:var(--ais-text-title-leading);margin:0}p{margin:0}.lead-form{display:grid;grid-template-columns:1fr 1fr;gap:16px}label{display:grid;gap:4px}input:not([type=checkbox]),textarea{font:inherit;min-height:48px;width:100%;border:1px solid var(--web-line-strong);padding:10px;background:white;color:inherit}textarea{min-height:96px}.full{grid-column:1/-1}.consent{display:flex;align-items:center;gap:8px}button{font:500 16px Inter;background:var(--web-action);color:var(--web-page);border:0;min-height:48px;padding:12px 24px;width:max-content}body:has(.site-bar){padding:0}.site-bar{display:flex;justify-content:flex-end;padding:16px 24px;min-height:220px}.language{position:relative;height:max-content}.language summary{display:flex;align-items:center;gap:6px;min-height:44px;padding:0 12px;font-weight:600;font-size:14px;cursor:pointer;list-style:none}.language summary::-webkit-details-marker{display:none}.language summary svg{width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;opacity:.6}.language[open] summary svg{transform:rotate(180deg)}.language ul{position:absolute;right:0;top:calc(100% + 8px);width:224px;margin:0;padding:6px 0;list-style:none;background:var(--web-page);border:1px solid var(--web-line)}.language li>*{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;font-size:14px;text-decoration:none;color:var(--web-ink)}.language a:hover{background:var(--web-hover-fill);color:var(--web-link)}.language [aria-current]{color:var(--web-link);font-weight:500}.language [aria-current] svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.language small{font-size:12px;font-weight:600;color:var(--web-muted,#6b7280)}a:focus-visible,button:focus-visible,input:focus-visible,summary:focus-visible{outline:2px solid var(--web-link);outline-offset:2px}@media(max-width:600px){.page-opener,.lead-form{grid-template-columns:1fr}.full{grid-column:auto}}
.product-film{margin:0}.product-film video{display:block;width:100%;height:auto;border:1px solid var(--ais-neutral-200);border-radius:4px;box-shadow:var(--ais-shadow-raised)}.product-film figcaption{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:16px}.product-film [data-chapter]{font:var(--ais-text-subheading-weight) var(--ais-text-subheading)/var(--ais-text-subheading-leading) var(--ais-font-primary)}.product-film .film-control{display:grid;place-items:center;width:44px;height:44px;min-height:44px;padding:0;background:transparent;color:var(--ais-blue-700)}.film-control:hover{background:var(--ais-blue-50)}
</style></head><body><Fragment set:html={example.code}/><script is:inline>document.querySelector('form')?.addEventListener('submit',e=>e.preventDefault());new ResizeObserver(()=>parent.postMessage({preview:location.pathname,height:Math.ceil(document.body.getBoundingClientRect().height)+2},location.origin)).observe(document.body);
const film=document.querySelector('.product-film');
if(film){const video=film.querySelector('video'),button=film.querySelector('button'),chapters=JSON.parse(film.dataset.chapters);let visible=false,manualPause=false;const reduced=matchMedia('(prefers-reduced-motion: reduce)');const sync=()=>{const playing=!video.paused;button.setAttribute('aria-pressed',String(playing));button.setAttribute('aria-label',playing?button.dataset.pause:button.dataset.play);button.querySelector('svg').innerHTML=playing?'<rect x="14" y="3" width="5" height="18" rx="1"/><rect x="5" y="3" width="5" height="18" rx="1"/>':'<path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/>';};const automatic=()=>{if(!visible||document.hidden)video.pause();else if(!manualPause&&!reduced.matches)video.play().catch(()=>{});};button.addEventListener('click',()=>{if(video.paused){manualPause=false;video.play().catch(()=>{});}else{manualPause=true;video.pause();}});video.addEventListener('play',sync);video.addEventListener('pause',sync);video.addEventListener('timeupdate',()=>{film.querySelector('[data-chapter]').textContent=chapters.findLast(chapter=>chapter.start<=video.currentTime)?.title??chapters[0].title;});new IntersectionObserver(entries=>{visible=entries[0].intersectionRatio>=.15;automatic();},{threshold:.15}).observe(video);document.addEventListener('visibilitychange',automatic);reduced.addEventListener('change',()=>{if(reduced.matches)video.pause();else automatic();});}
</script></body></html>
