---
import type { Lang } from '../i18n';
import { illustrations, versionCopy } from '../library';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = versionCopy[lang];
---
<ul class="library">
  {illustrations.map((f) => {
    const [id, ext] = f.file.split('.');
    const format = ext === 'svg' ? 'SVG' : 'WebP';
    return (
      <li class:list={[ext !== 'svg' && 'wide']}>
        <figure>
          <div class="pair">
            {(['light', 'dark'] as const).map((version) => (
              <div>
                <div class:list={['art', version]}><img src={`/illustrations/${id}-${version}.${ext}`} alt={f.shows[lang]} loading="lazy" /></div>
                <a href={`/illustrations/${id}-${version}.${ext}`} download>{t[version](format)}</a>
              </div>
            ))}
          </div>
          <figcaption>
            <strong>{f.name[lang]}</strong>
            <span>{f.shows[lang]}</span>
          </figcaption>
        </figure>
      </li>
    );
  })}
</ul>
<style>
  .library { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 24px; }
  .library li { margin: 0 !important; min-width: 0; }
  .library li.wide { grid-column: 1 / -1; }
  figure { margin: 0; }
  .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .art { aspect-ratio: 4 / 3; padding: 8px; overflow: hidden; background: var(--ais-neutral-50); border: 1px solid var(--line); border-radius: 0; }
  .art.dark { background: var(--ais-blue-950); border-color: var(--ais-blue-950); }
  .wide .art { aspect-ratio: 1200 / 924; }
  .art img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .pair a { display: inline-block; margin-top: 8px; font-size: var(--ais-text-caption); line-height: var(--ais-text-caption-leading); letter-spacing: var(--ais-text-caption-tracking); font-weight: var(--ais-text-caption-weight); }
  figcaption { display: flex; flex-direction: column; gap: 2px; margin-top: 8px; font-size: var(--ais-text-small); line-height: 1.4; line-height: var(--ais-text-small-leading); letter-spacing: var(--ais-text-small-tracking); font-weight: var(--ais-text-small-weight); }
  figcaption strong { font-weight: 600; color: var(--ink); }
  figcaption span { color: var(--muted); font-size: var(--ais-text-caption); line-height: var(--ais-text-caption-leading); letter-spacing: var(--ais-text-caption-tracking); font-weight: var(--ais-text-caption-weight); }
  @media (max-width: 760px) { .library { grid-template-columns: minmax(0, 1fr); } }
</style>
