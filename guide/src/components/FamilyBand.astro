---
import fs from 'node:fs';
import path from 'node:path';
// Optical corrections, measured on the rendered strip: `k` scales a column so every AIS mark has the same
// letter height (the wide GROUP descriptor makes AIS Group's letters 4% smaller), and `y` centres the
// Rosepetal wordmark and the AIS Group letters (taller descriptor) on the shared AIS letter centre line.
const brands: [string, string, { k?: number; y?: string }?][] = [['ais-group', 'AIS Group', { k: 1.042, y: '4.5%' }], ['ais-vision-systems', 'AIS Vision Systems'], ['ais-vision-automation', 'AIS Vision Automation'], ['ais-scanology', 'AIS Scanology'], ['rosepetal', 'Rosepetal', { y: '-17%' }]];
// Each column is as wide as its logo's optical width (square root of its proportions),
// so the stacked AIS marks and the wide Rosepetal wordmark carry equal weight in one row at any size.
const ratio = (file: string) => {
  const [, , w, h] = fs.readFileSync(path.join(process.cwd(), 'public/logos', `${file}-white.svg`), 'utf8').match(/viewBox="([^"]+)"/)![1].split(/[\s,]+/).map(Number);
  return w / h;
};
const columns = brands.map(([file, , fix]) => `${(Math.sqrt(ratio(file)) * (fix?.k ?? 1)).toFixed(3)}fr`).join(' ');
---
<figure class="family">
  <ul style={`grid-template-columns:${columns}`}>
    {brands.map(([file, name, fix]) => <li><img src={`/logos/${file}-white.svg`} alt={name} style={fix?.y && `translate:0 ${fix.y}`} /></li>)}
  </ul>
</figure>
<style>
  .family { margin: 40px 0 8px; background: var(--primary); padding: clamp(32px, 5vw, 64px) clamp(24px, 4.5vw, 48px); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; align-items: center; column-gap: clamp(16px, 5%, 48px); }
  li { margin: 0 !important; min-width: 0; }
  img { display: block; width: 100%; height: auto; }
  @media (max-width: 600px) {
    .family { padding: 32px 16px; }
    ul { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 32px 48px; }
    li { flex: none; }
    li:nth-child(1) { width: 72px; } li:nth-child(2) { width: 100px; } li:nth-child(3) { width: 110px; }
    li:nth-child(4) { width: 95px; } li:nth-child(5) { width: 130px; }
    img { translate: none !important; }
  }
</style>
