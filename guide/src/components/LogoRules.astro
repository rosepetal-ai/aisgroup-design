---
import type { Lang } from '../i18n';
interface Props { lang: Lang; part: 'space' | 'size' | 'donts' }
const { lang, part } = Astro.props;
const t = {
 en: { space: 'Clear space: x = ¼ of the total logo height', screen: 'On screen, at minimum width', dont: 'Do not', errors: ['Stretch', 'Recolour', 'Use a busy background', 'Add effects'] },
 es: { space: 'Área de respeto: x = ¼ de la altura total del logotipo', screen: 'En pantalla, al ancho mínimo', dont: 'No', errors: ['Estirar', 'Cambiar el color', 'Usar un fondo recargado', 'Añadir efectos'] },
 ca: { space: 'Espai de respecte: x = ¼ de l’alçada total del logotip', screen: 'En pantalla, a l’amplada mínima', dont: 'No', errors: ['Estirar', 'Canviar el color', 'Fer servir un fons carregat', 'Afegir efectes'] },
}[lang];
const brands = [['ais-group', 'AIS Group', 72, 15], ['ais-vision-systems', 'AIS Vision Systems', 100, 18], ['ais-vision-automation', 'AIS Vision Automation', 110, 20], ['ais-scanology', 'AIS Scanology', 95, 17], ['rosepetal', 'Rosepetal', 130, 24]];
---
{part === 'space' && <figure class="clear-space">
 <div class="margin"><span class="x x-top">x</span><span class="x x-left">x</span><span class="x x-right">x</span><span class="x x-bottom">x</span><img src="/logos/ais-vision-systems-blue.svg" alt="AIS Vision Systems" /></div>
 <figcaption>{t.space}</figcaption>
</figure>}
{part === 'size' && <figure class="minimum"><ul>{brands.map(([id, name, px, mm]) => <li><div class="size-frame"><img src={`/logos/${id}-blue.svg`} alt={String(name)} style={`width:${px}px;max-width:none`} /></div><strong>{name}</strong><span>{px} px, {mm} mm</span></li>)}</ul><figcaption>{t.screen}</figcaption></figure>}
{part === 'donts' && <ul class="donts">{t.errors.map((label, i) => <li><div class:list={['wrong', `wrong-${i}`]} data-brand-check="skip"><img src="/logos/ais-vision-systems-blue.svg" alt="" /></div><p><b aria-hidden="true">×</b> {t.dont}: {label}</p></li>)}</ul>}
<style>
 figure { margin: 24px 0; }
 figcaption { margin-top: 16px; font-size: 16px; }
 .clear-space { border: 1px solid var(--line); padding: 32px; }
 .margin { position: relative; width: 216.96px; padding: 27.48px; border: 1px dashed var(--link); margin: 8px auto 32px; }
 .margin img { display: block; width: 160px; height: auto; outline: 1px solid var(--line); }
 .x { position: absolute; color: var(--link); font-family: var(--mono); }
 .x-top { top: 2px; left: 50%; } .x-bottom { bottom: 2px; left: 50%; } .x-left { left: 8px; top: 45%; } .x-right { right: 8px; top: 45%; }
 ul { padding: 0; margin: 0; list-style: none; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; }
 li { margin: 0 !important; min-width: 0; }
 .size-frame { height: 120px; display: flex; align-items: center; border-bottom: 1px solid var(--line); margin-bottom: 12px; }
 strong, li > span { display: block; font-size: 14px; }
 .donts { grid-template-columns: repeat(4,minmax(0,1fr)); margin-top: 24px; }
 .wrong { min-height: 160px; display: grid; place-items: center; overflow: hidden; padding: 24px; background: var(--ais-neutral-100); }
 .wrong img { width: 110px; }
 .wrong-0 img { transform: scaleX(1.5) scaleY(.7); }
 .wrong-1 img { filter: hue-rotate(110deg); }
 .wrong-2 { background: url('/imagery/line-1.webp') center / cover; }
 .wrong-3 img { filter: drop-shadow(5px 5px 2px #4B5563); }
 .donts p { margin: 8px 0 0; font-size: 14px; }
 .donts b { color: var(--ais-danger); font-size: 20px; }
 @media(max-width:600px) { ul,.donts { grid-template-columns: repeat(2,minmax(0,1fr)); } .clear-space { padding: 24px; } }
</style>
