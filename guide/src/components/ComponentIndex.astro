---
import {blockItems,componentItems,examples,localizePart} from '../design/package';
import * as web from '../design/web';
import type {Lang} from '../i18n';
import fs from 'node:fs';
import path from 'node:path';
interface Props{lang:Lang;group:'components'|'blocks'|'web'}
const {lang,group}=Astro.props;
const names={en:['Actions and navigation','Forms and choices','Data and content','Feedback and progress','Panels and overlays','Page structure'],es:['Acciones y navegación','Formularios y opciones','Datos y contenido','Estado y progreso','Paneles y capas','Estructura de página'],ca:['Accions i navegació','Formularis i opcions','Dades i contingut','Estat i progrés','Panells i capes','Estructura de pàgina']}[lang];
const sets=[['button','breadcrumb','navigation-menu','pagination','dropdown-menu','tabs','toggle','toggle-group'],['field','input','input-group','checkbox','radio-group','select','combobox','label','textarea','slider','switch'],['table','card','item','avatar','badge','carousel','scroll-area','separator','kbd','log-terminal'],['alert','empty','progress','skeleton','spinner','sonner'],['dialog','alert-dialog','popover','sheet','tooltip','collapsible','accordion','confirm-dialog','confirm-host'],['sidebar','top-bar','login-page','form-dialog']];
// The website components (@aisgroup/web) share the cards: one group, no heading, their own previews and pages.
const isWeb=group==='web';
const items=isWeb?web.componentItems.map(p=>web.localizePart(p,lang)):(group==='components'?componentItems:blockItems).map(p=>localizePart(p,lang));
const groups=isWeb?[{name:'',items}]:names.map((name,i)=>({name,items:items.filter(p=>sets[i].includes(p.id)||(i===5&&!sets.some(s=>s.includes(p.id))))})).filter(g=>g.items.length);
const preview=(p:{id:string})=>{if(isWeb)return `/preview/web/${web.examples(p.id,lang)[0].path}/?mini`;const options=examples(p.id,lang);const e=p.id==='dropdown-menu'?(options[1]??options[0]):options[0];return `/preview/${e.path}/?mini`;};
const page=(p:{id:string})=>`/${lang}/${isWeb?'web-components':'components'}/${p.id}/`;
// Each card shows a still of its mini preview (scripts/preview-thumbnails.mjs), so the index appears at once; a card
// without one yet falls back to the live preview and the build says so.
const thumb=(p:{id:string})=>`/previews/mini/${preview(p).replace(/^\/preview\//,'').replace(/\/\?mini$/,'').replaceAll('/','--')}.png`;
const has=(p:{id:string})=>{const ok=fs.existsSync(path.join(process.cwd(),'public',thumb(p)));if(!ok)console.warn(`ComponentIndex: no thumbnail ${thumb(p)}; run guide/scripts/preview-thumbnails.mjs`);return ok;};
---
{groups.map(g=><section class="component-group">{g.name&&<h3>{g.name}</h3>}<ul class="component-index preview-cards">{g.items.map(p=><li><div class="mini" inert aria-hidden="true">{has(p)?<img src={thumb(p)} alt="" width="504" height="340" loading="lazy" decoding="async" data-thumb={thumb(p)} data-preview={preview(p)} />:<iframe data-src={preview(p)} title={p.name} tabindex="-1" data-thumb={thumb(p)} data-preview={preview(p)}></iframe>}</div><a href={page(p)}>{p.name}</a><p>{p.description}</p></li>)}</ul></section>)}
<style>
.preview-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;list-style:none;margin:24px 0;padding:0}.preview-cards li{margin:0!important;min-width:0}.mini{height:170px;overflow:hidden;background:var(--ais-neutral-0);border:1px solid var(--line);margin-bottom:12px}.mini img{display:block;width:100%;height:100%;object-fit:contain}.mini iframe{display:block;border:0;width:200%;height:340px;transform:scale(.5);transform-origin:top left;pointer-events:none}a{font-weight:500;font-size:var(--ais-text-body)}p{margin:8px 0 0;font-size:var(--ais-text-small);line-height:var(--ais-text-small-leading);color:var(--muted)}@media(max-width:1100px){.preview-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.preview-cards{grid-template-columns:1fr}.mini iframe{width:100%;height:170px;transform:none}}
</style>
<script is:inline>
  // Live fallbacks load only as they come near the screen: the browser's own lazy margin starts dozens at once.
  (() => { const io = new IntersectionObserver((es) => es.forEach((e) => { if (!e.isIntersecting) return; e.target.src = e.target.dataset.src; io.unobserve(e.target); }), { rootMargin: '200px 0px' });
  document.querySelectorAll('.mini iframe[data-src]').forEach((f) => io.observe(f)); })();
</script>
