{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/components/ui/*": ["../packages/design/ui/*"],
      "@/components/blocks/*": ["../packages/design/blocks/*"],
      "@/lib/utils": ["../packages/design/lib/utils.ts"],
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "../packages/design/**/*.ts", "../packages/design/**/*.vue"], "exclude": ["../packages/design/examples/**", "src/playground/**/*.vue"]
}
