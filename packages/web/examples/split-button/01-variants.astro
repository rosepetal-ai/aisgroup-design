import SplitButton from '@aisgroup/web/components/split-button'
---
<SplitButton href="/contact/">Tell us about your line</SplitButton>
<SplitButton href="/quote/" variant="secondary">Request a quote</SplitButton>
<div style="padding: 24px; background: var(--web-band)">
  <SplitButton href="/contact/" variant="white">Tell us about your line</SplitButton>
</div>
