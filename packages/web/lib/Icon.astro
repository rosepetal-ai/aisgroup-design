---
import { icons, type IconName } from './icons';
interface Props { name: IconName; size?: 16 | 18 | 20 | 24; label?: string; class?: string; [key: string]: unknown }
const { name, size = 20, label, class: className, ...rest } = Astro.props;
---
<svg class:list={['lucide', className]} xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : 'true'} aria-label={label} role={label ? 'img' : undefined} {...rest} set:html={icons[name]} />
